<?xml version="1.0"?>
<launch>
    <!-- Hand Tracker Node Launch File -->
    
    <!-- Arguments for easy configuration -->
    <arg name="camera_topic" default="/cam/image_raw" 
         doc="Input camera topic name"/>
    <arg name="max_speed" default="0.05" 
         doc="Maximum velocity in m/s (default: 0.05 = 5 cm/s)"/>
    <arg name="deadzone" default="0.05" 
         doc="Deadzone threshold for zero detection (default: 0.05)"/>
    <arg name="output" default="screen" 
         doc="Output destination: screen or log"/>
    
    <!-- Hand Tracker Node -->
    <node pkg="ros" 
          type="hand_tracker_node.py" 
          name="hand_tracker" 
          output="$(arg output)">
        
        <!-- Parameters -->
        <param name="camera_topic" value="$(arg camera_topic)"/>
        <param name="max_speed" value="$(arg max_speed)"/>
        <param name="deadzone" value="$(arg deadzone)"/>
    </node>
    
    <!-- Launch camera node if not already running -->
    <!--
    <node pkg="usb_cam" type="usb_cam_node" name="usb_cam">
        <param name="video_device" value="/dev/video0"/>
        <param name="image_width" value="640"/>
        <param name="image_height" value="480"/>
        <param name="pixel_format" value="yuyv"/>
        <param name="camera_frame_id" value="usb_cam"/>
        <param name="io_method" value="mmap"/>
    </node>
    -->
    
</launch>
